NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cantley
CLIENT_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_ACCESS_SECRET=replace-with-a-long-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@your-domain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="Cantley <your-mailbox@your-domain.com>"
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-separate-webhook-secret
